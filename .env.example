# ── Admin access (required) ───────────────────────────────────────────
# The password you type at /admin/login. Use something long.
# Wrap it in single quotes if it contains # or $ (e.g. ADMIN_PASSWORD='my#pass'),
# otherwise everything after # is ignored. On Vercel, paste it WITHOUT quotes.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# ── Content storage (required in production, optional locally) ────────
# Free Upstash Redis database (upstash.com, or Vercel → Storage → Upstash).
# Without these, content is read from / written to data/content.json,
# which works on your laptop but NOT on Vercel (read-only filesystem).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel's integration names (KV_REST_API_URL / KV_REST_API_TOKEN) also work.

# ── Optional ──────────────────────────────────────────────────────────
# Your production URL, used for social previews.
NEXT_PUBLIC_SITE_URL=
